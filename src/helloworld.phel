(ns amphp-demo.helloworld
  (:require [phel.async]))

;;; AMPHP Example "Hello World" https://amphp.org/installation

(defn my-function1 []
  (print "Hello ")
  (phel.async/delay 2)
  (print "the future!"))

(def future1 (async (my-function1)))

(defn my-function2 []
  (print "World ")
  (phel.async/delay 1)
  (print "from "))

(def future2 (async (my-function2)))

;; (await future1) equals to (.await future1)

(await-all [future1 future2])  ; await both futures
(println)
(phel.async/delay 1)

;; Prints:
;; Hello World from the future!

;; Additionally ^:async can be used for function definition to wrap it with
;; async since https://github.com/phel-lang/phel-lang/pull/1929

(defn ^:async my-async-function1 []
  (print "^:async Hello ")
  (phel.async/delay 2)
  (print "the future!"))

(def future1b (my-async-function1))

(defn ^:async my-async-function2 []
  (print "World ")
  (phel.async/delay 1)
  (print "from "))

(def future2b (my-async-function2))

(await-all [future1b future2b])

;; Prints:
;; ^:async Hello World from the future!
